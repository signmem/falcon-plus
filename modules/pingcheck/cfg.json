{
    "debug":true,
    "agent_check": true,   // check falcon-agent  false == 不发送报警  true == 发送报警
    "alarm_enable": true,  // alarmenable = true 允许告警， false 不执行告警
    "log_max_age": 432000,
    "log_rotate_age": 86400,
    "agent_expire" : 180,        // falcon-agent 
    "ping_dead_expire": 60,     // ping check
    "falcon_reping_concurrent": 300,
    "falcon_ping_concurrent": 100,
    "agent_priority":"3",        // send alarm priority, 默认 3 = 一般严重
    "check_ping_interval": 60,
    "check_interval": 60,        // interval to connect redis 每 60 秒检测 REDIS 一次 ( falcon-agent)
    "log_file": "/apps/svr/falcon-plus/pingcheck/logs/app.log",
    "alarm_file": "/apps/svr/falcon-plus/pingcheck/logs/alarm.log",
    // "excludedbatags": "DBA",      // 所有 DBA tag
    // "excludedbadeploytype": [80,81,85,83,82], // 对应了  mysql redis mongodb oracle memcache
    "exclude_bus_group": [
        "基础架构/数据库/mysql",
        "基础架构/数据库/redis",
        "基础架构/数据库/oracle",
        "基础架构/数据库/MC",
        "基础架构/数据库/MongoDB"
    ],
    "exclude_app_name": [],        // 过滤的 domain
    "http": {
        "enabled": true,
        "listen": "0.0.0.0:8080"
    },
    "redis": {
        "enabled": true,    // 是否读 redis , 不读 redis 则不对 redis 主机过期进行检测
        "server":"",
        "port": "6804",
        "max_idle": 20,
        "max_active":50,
        "idle_timeout": 60,
        "lock_key": "/falcon-pingcheck",
        "lock_time": 5,
        "ask_locktime": 3
    },
    "falcon": {
         "falconauth": "",
         "falconsign": "",
         "url": "http://falcon-api.vip.vip.com"
    },
    "falcon_agent": {
         "address": "127.0.0.1",
         "port": "22230",
         "step": 60
    },
    "cmdb": {
        "url": "http://test.cmdb3.api.vip.com",
        "sysname": "falcon-server",
        "token": ""
    },
    "pigeon": {
        "source": "vip-falcon",
        "key": "",
        "m3dburl":  "http://m3.api.vip.com/api/getdata",
        "pigeonurl": "http://pigeon.api.vip.com/alarm/report.do"
    },
    "transfer" : {
        "interval": 10,
        "enabled": true,
        "timeout": 1000,
        "addrs": [
            "gd13-falcon-transfer-001.idc.vip.com:8433",
            "gd13-falcon-transfer-002.idc.vip.com:8433"
        ],
        "servers": [
            "10.189.20.26:6060",
            "10.189.20.26:6060",
            "10.189.20.27:6060"
        ]
    },
    "degrade": {
        "enabled": true,    // 允许降级
        "period": 9,        // value 9 ==  10 个时间周期, 每个时间周期为 60 second
        "alarmlimit":  50,  // 每个时间周期最大只可以报警 50 台服务器，超过则降级
        "frozentime":  30   // 降级时，停止报警 30 分钟, 这 30 分钟内，只会忽略对应 agent, ping 故障服务器
    },
    "proxy": {
        "servers": [
            "gd15-falcon-pingproxy.vip.vip.com",
            "gd16-falcon-pingproxy.vip.vip.com",
            "js2-falcon-pingproxy.vip.vip.com"
        ]
    }
}
